{
  "name": "agent-think-map",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Visual debugger for AI agents: inspect tools, skills, MCP calls, subagents, latency, and cost beside Claude Code or Codex, or inside your product.",
  "keywords": [
    "ai",
    "agent",
    "trace",
    "think-map",
    "mcp",
    "claude",
    "claude-code",
    "openai",
    "codex",
    "observability",
    "nanoclaw"
  ],
  "homepage": "https://nimrodfisher.github.io/agent-think-map/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimrodfisher/agent-think-map.git"
  },
  "bugs": {
    "url": "https://github.com/nimrodfisher/agent-think-map/issues"
  },
  "author": "Nimrod Fisher",
  "type": "module",
  "bin": {
    "agent-think-map": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./react": {
      "types": "./dist/lib/react.d.ts",
      "import": "./dist/lib/react.js"
    },
    "./element": {
      "types": "./dist/lib/element.d.ts",
      "import": "./dist/lib/element.js"
    },
    "./claude": {
      "types": "./dist/lib/claude.d.ts",
      "import": "./dist/lib/claude.js"
    },
    "./claude-code": {
      "types": "./dist/lib/claude-code.d.ts",
      "import": "./dist/lib/claude-code.js"
    },
    "./openai": {
      "types": "./dist/lib/openai.d.ts",
      "import": "./dist/lib/openai.js"
    },
    "./codex": {
      "types": "./dist/lib/openai.d.ts",
      "import": "./dist/lib/openai.js"
    },
    "./styles.css": "./dist/styles.css",
    "./storage": {
      "types": "./dist/lib/storage.d.ts",
      "import": "./dist/lib/storage.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "fixtures",
    "packages",
    "LICENSE",
    "README.md",
    "tsconfig.base.json"
  ],
  "jsdelivr": "dist/element.cdn.js",
  "unpkg": "dist/element.cdn.js",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @agent-think-map/demo",
    "build": "npm run build:lib && npm run build:cdn",
    "build:cdn": "vite build --config vite.cdn.ts",
    "prepublishOnly": "npm test && npm run test:package",
    "build:lib": "tsup",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.8.4",
    "elkjs": "^0.10.0",
    "motion": "^12.23.12",
    "vite-node": "^3.2.4",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/lib/index.d.ts"
}
